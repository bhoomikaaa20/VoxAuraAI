# Copy this file to .env and fill in your keys. Never commit .env.

# --- Required API keys ---
ASSEMBLYAI_API_KEY=
OPENAI_API_KEY=

# --- Models (optional) ---
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- RAG settings (optional) ---
CHUNK_SIZE=800
CHUNK_OVERLAP=150
RETRIEVAL_K=4

# --- MySQL (optional) ---
# Leave DB_HOST empty to use a local SQLite file (data/voxaura.db) instead.
DB_HOST=
DB_USER=
DB_PASSWORD=
DB_DATABASE=

# --- Local storage (optional) ---
# DATA_DIR=data
