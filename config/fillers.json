{
  "_comment": "hesitations are always fillers. discourse_markers map a phrase to the rule that decides from the surrounding words whether it is a filler (see voxaura/text_cleaning.py for each rule). repetitions: a word said twice in a row ('the the') is a filler unless listed in allowed_repeats.",

  "hesitations": [
    "um", "umm", "ummm", "uh", "uhh", "uhhh", "uhm", "er", "err", "erm",
    "ah", "ahh", "ahhh", "ohh", "hmm", "hmmm", "mm", "mmm", "eh"
  ],

  "discourse_markers": {
    "like": "like",
    "you know": "you_know",
    "i mean": "i_mean",
    "you know what i mean": "always",
    "if you know what i mean": "always",
    "basically": "clause_start",
    "so yeah": "clause_start",
    "okay so": "clause_start",
    "so basically": "clause_start",
    "actually": "comma",
    "honestly": "comma",
    "literally": "comma",
    "obviously": "comma",
    "seriously": "comma",
    "well": "comma",
    "anyway": "comma",
    "anyways": "comma",
    "you see": "comma",
    "let's see": "comma",
    "how do i put it": "comma",
    "kind of": "hedge",
    "sort of": "hedge",
    "kinda": "hedge",
    "sorta": "hedge",
    "i guess": "edge",
    "i suppose": "edge",
    "or something": "clause_end",
    "or something like that": "clause_end",
    "and stuff": "clause_end",
    "and stuff like that": "clause_end",
    "or whatever": "clause_end",
    "and everything": "clause_end",
    "right": "tag",
    "okay": "tag"
  },

  "repetitions": {
    "enabled": true,
    "allowed_repeats": ["that", "had", "very", "no", "bye", "really", "ha", "la", "knock", "night",
                        "many", "more", "far", "round", "over", "again", "yes", "go", "hey", "well",
                        "so", "is", "do", "boo", "chop", "tut", "pom", "bla", "blah", "yeah", "now"]
  }
}
